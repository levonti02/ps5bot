# Telegram
BOT_TOKEN=123456:ABC-DEF
ADMIN_IDS=[123456789]

# Database
DATABASE_URL=postgresql+asyncpg://ps5bot:ps5bot@db:5432/ps5bot

# YooKassa (leave empty when PAYMENT_MOCK=true)
YOOKASSA_SHOP_ID=your_shop_id
YOOKASSA_SECRET_KEY=your_secret_key
YOOKASSA_RETURN_URL=https://t.me/your_bot

# Mock payment: true = instant payment without YooKassa, false = real YooKassa
PAYMENT_MOCK=true

# Webhook
WEBHOOK_HOST=https://your-domain.com
FASTAPI_PORT=8000

# Timezone
TIMEZONE=Europe/Moscow
